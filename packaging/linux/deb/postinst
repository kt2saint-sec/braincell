#!/bin/sh
# postinst for braincell-mcp — creates the private venv from the bundled
# wheelhouse (fully offline: --no-index) and symlinks the console scripts.
set -e

VENV=/opt/braincell-mcp/venv
WHEELS=/usr/share/braincell-mcp/wheels

case "$1" in
    configure)
        # --clear makes upgrades idempotent (rebuild from the new wheelhouse).
        python3 -m venv --clear "$VENV"
        "$VENV/bin/pip" install --quiet --no-index --no-cache-dir \
            --find-links "$WHEELS" "braincell-mcp"

        for exe in braincell braincell-mcp braincell-map; do
            ln -sf "$VENV/bin/$exe" "/usr/bin/$exe"
        done

        if ! command -v ollama >/dev/null 2>&1; then
            echo "braincell-mcp: NOTE - 'ollama' was not found on PATH." >&2
            echo "  braincell needs a local Ollama with an embedding model:" >&2
            echo "    https://ollama.com/download" >&2
            echo "    ollama pull qwen3-embedding:4b" >&2
            echo "  (Ollama is not in the Debian/Ubuntu archives, so it cannot" >&2
            echo "  be a package dependency.)" >&2
        fi
        ;;
esac

exit 0
